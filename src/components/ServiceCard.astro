---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';

interface Props {
  service: CollectionEntry<'services'>;
  index?: number;
}
const { service, index } = Astro.props;
const { data } = service;
---

<a
  href={url(`services/${service.id}/`)}
  class="group flex flex-col bg-bone no-underline ring-1 ring-sand transition hover:ring-orange"
>
  <div class="overflow-hidden">
    <Image
      src={data.hero}
      alt={data.heroAlt}
      widths={[400, 640]}
      width={640}
      sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
      class="aspect-[3/2] w-full object-cover transition duration-500 group-hover:scale-[1.03]"
    />
  </div>
  <div class="flex flex-1 flex-col border-t-2 border-orange p-6">
    {index !== undefined && (
      <span class="text-xs font-semibold tracking-[0.2em] text-gravel">
        {String(index + 1).padStart(2, '0')}
      </span>
    )}
    <h3 class="mt-1 text-2xl text-charcoal">{data.short}</h3>
    <p class="mt-2 flex-1 text-[15px] text-stone">{data.summary}</p>
    <span class="mt-5 text-xs font-semibold tracking-[0.18em] text-orange-700 uppercase group-hover:text-orange-800">
      View service →
    </span>
  </div>
</a>

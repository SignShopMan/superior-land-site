---
// Text lockup used until the logo is redrawn for the refined direction.
import Mark from './Mark.astro';

interface Props {
  class?: string;
  tone?: 'light' | 'dark';
}
const { class: className = '', tone = 'light' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-3', className]}>
  <Mark class="size-9 shrink-0 text-copper-300" />
  <span class="flex flex-col leading-none">
    <span
      class:list={[
        'font-display text-[1.6em] font-semibold tracking-[0.12em] uppercase',
        tone === 'light' ? 'text-white' : 'text-iron',
      ]}
    >
      Superior
    </span>
    <span
      class:list={[
        'mt-1 text-[0.62em] font-medium tracking-[0.32em] uppercase',
        tone === 'light' ? 'text-gravel' : 'text-stone',
      ]}
    >
      Land &amp; Site Services
    </span>
  </span>
</span>

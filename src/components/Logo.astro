---
// Final logo artwork, generated by brand/tools/build_logos.py from the master in brand/.
// Both are the dark-background versions: header and footer are charcoal.
import wordmark from '../assets/brand/superior-wordmark-dark.svg';
import badge from '../assets/brand/superior-logo-dark.svg';
import { site } from '../data/site';

interface Props {
  variant?: 'wordmark' | 'badge';
  class?: string;
}
const { variant = 'wordmark', class: className } = Astro.props;
const art = variant === 'badge' ? badge : wordmark;
---

<img
  src={art.src}
  width={art.width}
  height={art.height}
  alt={site.name}
  class:list={['block', className]}
  decoding="async"
/>

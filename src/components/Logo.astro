---
// Final logo artwork, generated by brand/tools/build_logos.py from the master in brand/.
// All are the dark-background versions: header and footer are charcoal.
import lockup from '../assets/brand/superior-lockup-horizontal-dark.svg';
import badge from '../assets/brand/superior-logo-dark.svg';
import mark from '../assets/brand/superior-mark-dark.svg';
import { site } from '../data/site';

interface Props {
  variant?: 'lockup' | 'badge' | 'mark';
  class?: string;
}
const { variant = 'lockup', class: className } = Astro.props;
const art = { lockup, badge, mark }[variant];
---

<img
  src={art.src}
  width={art.width}
  height={art.height}
  alt={site.name}
  class:list={['block', className]}
  decoding="async"
/>

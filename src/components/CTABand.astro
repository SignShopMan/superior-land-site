---
import Button from './Button.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props {
  heading?: string;
  text?: string;
}
const {
  heading = 'Have a site that needs work?',
  text = 'Send us the plans, the scope or just the location. We walk every site and return a written bid.',
} = Astro.props;
---

<section class="bg-contours relative overflow-hidden bg-iron text-white">
  <div class="container-site relative grid items-end gap-10 py-20 md:grid-cols-[1.4fr_1fr] md:py-24">
    <div>
      <p class="eyebrow eyebrow-light">Next step</p>
      <h2 class="max-w-2xl text-4xl md:text-6xl">{heading}</h2>
      <p class="mt-5 max-w-xl text-lg text-gravel">{text}</p>
    </div>
    <div class="flex flex-wrap gap-3 md:justify-end">
      <Button href={url('contact/')} size="lg">
        Request a Bid
      </Button>
      <Button href={site.phoneHref} variant="outline-light" size="lg">
        {site.phone}
      </Button>
    </div>
  </div>
</section>

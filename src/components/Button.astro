---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'outline' | 'outline-light' | 'link';
interface Props extends HTMLAttributes<'a'> {
  variant?: Variant;
  size?: 'md' | 'lg';
}
const { variant = 'primary', size = 'md', class: className, ...rest } = Astro.props;

const variants: Record<Variant, string> = {
  primary: 'bg-copper text-white hover:bg-copper-700',
  outline: 'border border-iron text-iron hover:bg-iron hover:text-white',
  'outline-light':
    'border border-white/40 text-white hover:border-white hover:bg-white hover:text-iron',
  link: 'px-0! text-copper-600 hover:text-copper-800',
};
---

<a
  class:list={[
    'inline-flex items-center justify-center gap-2.5 rounded-(--radius-btn) font-semibold tracking-[0.08em] whitespace-nowrap uppercase no-underline transition-colors',
    size === 'lg' ? 'px-7 py-4 text-sm' : 'px-5 py-3 text-[13px]',
    variants[variant],
    className,
  ]}
  {...rest}
>
  <slot />
</a>

---
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { url } from '../lib/url';

// Static host → post to Web3Forms (https://web3forms.com). PUBLIC_WEB3FORMS_KEY comes from .env / repo secret.
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const redirect = new URL(url('thanks/'), Astro.site).href;
const label = 'text-xs font-semibold tracking-[0.14em] text-slate uppercase';
const field =
  'mt-2 w-full rounded-(--radius-btn) border border-sand bg-white px-4 py-3 text-base text-charcoal normal-case tracking-normal placeholder:text-gravel focus:border-orange focus:ring-1 focus:ring-orange focus:outline-none';
---

<form
  id="bid-form"
  action="https://api.web3forms.com/submit"
  method="POST"
  class="grid gap-5 bg-bone p-6 ring-1 ring-sand sm:grid-cols-2 md:p-10"
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value={`New bid request — ${site.name}`} />
  <input type="hidden" name="from_name" value={site.name} />
  <input type="hidden" name="redirect" value={redirect} />
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    style="display:none"
    tabindex="-1"
    autocomplete="off"
  />

  <div
    id="bid-errors"
    role="alert"
    tabindex="-1"
    hidden
    class="border-l-2 border-orange-700 bg-orange-50 p-4 text-sm text-orange-800 sm:col-span-2"
  ></div>

  <fieldset class="sm:col-span-2">
    <legend class={label}>Project type</legend>
    <div class="mt-2 grid gap-2 sm:grid-cols-3">
      {[
        ['Commercial', 'GC, developer, business'],
        ['Municipal', 'Township, village, county'],
        [`Residential ${site.minResidentialAcres}+ acres`, 'Estate or acreage property'],
      ].map(([value, hint], i) => (
        <label class="flex cursor-pointer gap-3 border border-sand bg-white p-4 has-checked:border-orange has-checked:ring-1 has-checked:ring-orange">
          <input
            type="radio"
            name="project_type"
            value={value}
            required
            checked={i === 0}
            class="mt-1 accent-orange"
          />
          <span>
            <span class="block font-semibold">{value}</span>
            <span class="text-sm text-stone">{hint}</span>
          </span>
        </label>
      ))}
    </div>
  </fieldset>

  <label class={label}>
    Name
    <input class={field} type="text" name="name" autocomplete="name" required />
  </label>
  <label class={label}>
    Company / organization <span class="font-normal text-gravel normal-case">(optional)</span>
    <input class={field} type="text" name="organization" autocomplete="organization" />
  </label>
  <label class={label}>
    Phone
    <input class={field} type="tel" name="phone" autocomplete="tel" required />
  </label>
  <label class={label}>
    Email <span class="font-normal text-gravel normal-case">(optional)</span>
    <input class={field} type="email" name="email" autocomplete="email" />
  </label>
  <label class={label}>
    Project location
    <input class={field} type="text" name="location" placeholder="Town, road or address" required />
  </label>
  <label class={label}>
    Approx. size <span class="font-normal text-gravel normal-case">(acres or feet)</span>
    <input class={field} type="text" name="size" placeholder="e.g. 6 acres, 1,200 ft of road" />
  </label>
  <label class={label}>
    Primary service
    <select class={field} name="service" id="bid-service" required>
      <option value="">Choose a service…</option>
      {services.map((s) => (
        <option>{s.data.short}</option>
      ))}
      <option>Multiple / not sure</option>
    </select>
  </label>
  <label class={label}>
    Timeline
    <select class={field} name="timeline">
      <option>Flexible</option>
      <option>Within 30 days</option>
      <option>1–3 months</option>
      <option>Bidding a future project</option>
    </select>
  </label>
  <label class:list={[label, 'sm:col-span-2']}>
    Scope / details
    <textarea
      class={field}
      name="message"
      rows="5"
      placeholder="What's on site now, what you need done, and any plans or specs we should see."
    ></textarea>
  </label>
  <div class="flex flex-wrap items-center gap-5 sm:col-span-2">
    <button
      type="submit"
      class="rounded-(--radius-btn) bg-orange px-8 py-4 text-sm font-semibold tracking-[0.1em] text-charcoal uppercase hover:bg-orange-400"
    >
      Submit Bid Request
    </button>
    <p class="text-sm text-stone">
      Prefer to talk? Call{' '}
      <a href={site.phoneHref} class="font-semibold text-orange-700">
        {site.phone}
      </a>
    </p>
  </div>
  <p class="text-sm text-stone sm:col-span-2">
    We focus on commercial, municipal and residential properties of {site.minResidentialAcres} acres
    or more. We only use these details to respond to your request.
  </p>
  {!accessKey && import.meta.env.DEV && (
    <p class="bg-orange-50 p-3 text-sm text-orange-800 sm:col-span-2">
      Dev note: PUBLIC_WEB3FORMS_KEY is not set, so submissions won't deliver.
    </p>
  )}
</form>

<script>
  const form = document.getElementById('bid-form') as HTMLFormElement | null;
  const errors = document.getElementById('bid-errors');
  const service = document.getElementById('bid-service') as HTMLSelectElement | null;

  // Arriving from a service page: preselect that service.
  const wanted = new URLSearchParams(location.search).get('service');
  if (service && wanted) {
    const match = [...service.options].find((o) => o.text === wanted);
    if (match) service.value = match.value || match.text;
  }

  // On a failed submit, list every missing field at the top instead of one tooltip at a time.
  const nameOf = (el: Element) => {
    if (el instanceof HTMLInputElement && el.type === 'radio') return 'Project type';
    const label = el.closest('label');
    return (label?.firstChild?.textContent ?? (el as HTMLInputElement).name).trim();
  };
  form?.querySelector('button[type="submit"]')?.addEventListener('click', () => {
    if (!form || !errors) return;
    const bad = [...form.querySelectorAll(':invalid')].filter(
      (el) => (el as HTMLInputElement).name,
    );
    if (bad.length === 0) {
      errors.hidden = true;
      return;
    }
    const names = [...new Set(bad.map(nameOf))];
    errors.textContent = `Please fill in: ${names.join(', ')}.`;
    errors.hidden = false;
  });
  form?.addEventListener('input', () => {
    if (errors && !errors.hidden && form.checkValidity()) errors.hidden = true;
  });
</script>

---
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { url } from '../lib/url';

// Static host → post to Web3Forms (https://web3forms.com). Set PUBLIC_WEB3FORMS_KEY in .env / repo secrets.
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const redirect = new URL(url('thanks/'), Astro.site).href;
const field =
  'mt-1 w-full rounded-md border border-chrome-300 bg-white px-4 py-3 text-ink placeholder:text-steel focus:border-orange focus:ring-2 focus:ring-orange/40 focus:outline-none';
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  class="grid gap-4 rounded-(--radius-card) bg-white p-6 shadow-xl ring-1 ring-chrome-100 sm:grid-cols-2 md:p-8"
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value={`New quote request — ${site.name}`} />
  <input type="hidden" name="from_name" value={site.name} />
  <input type="hidden" name="redirect" value={redirect} />
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    style="display:none"
    tabindex="-1"
    autocomplete="off"
  />

  <label class="font-semibold">
    Name
    <input class={field} type="text" name="name" autocomplete="name" required />
  </label>
  <label class="font-semibold">
    Phone
    <input class={field} type="tel" name="phone" autocomplete="tel" required />
  </label>
  <label class="font-semibold">
    Email <span class="font-normal text-steel">(optional)</span>
    <input class={field} type="email" name="email" autocomplete="email" />
  </label>
  <label class="font-semibold">
    Job location (town)
    <input class={field} type="text" name="town" autocomplete="address-level2" required />
  </label>
  <label class="font-semibold sm:col-span-2">
    What do you need?
    <select class={field} name="service" required>
      <option value="">Choose a service…</option>
      {services.map((s) => (
        <option>{s.data.short}</option>
      ))}
      <option>Something else</option>
    </select>
  </label>
  <label class="font-semibold sm:col-span-2">
    Tell us about the job
    <textarea
      class={field}
      name="message"
      rows="4"
      placeholder="Size of the area, what's there now, and when you'd like it done."
    ></textarea>
  </label>
  <div class="flex flex-wrap items-center gap-4 sm:col-span-2">
    <button
      type="submit"
      class="rounded-(--radius-btn) bg-orange px-7 py-4 font-display text-xl font-extrabold tracking-wide text-ink uppercase italic hover:bg-orange-400"
    >
      Send My Quote Request
    </button>
    <p class="text-sm text-steel">
      Rather talk? Call{' '}
      <a href={site.phoneHref} class="font-bold text-orange-700">
        {site.phone}
      </a>
    </p>
  </div>
  {!accessKey && import.meta.env.DEV && (
    <p class="rounded-md bg-orange-50 p-3 text-sm text-orange-800 sm:col-span-2">
      Dev note: PUBLIC_WEB3FORMS_KEY is not set, so submissions won't deliver.
    </p>
  )}
</form>

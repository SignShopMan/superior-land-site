---
import { getCollection } from 'astro:content';
import { site } from '../data/site';
import { url } from '../lib/url';

// Static host → post to Web3Forms (https://web3forms.com). PUBLIC_WEB3FORMS_KEY comes from .env / repo secret.
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const redirect = new URL(url('thanks/'), Astro.site).href;
const label = 'text-xs font-semibold tracking-[0.14em] text-slate uppercase';
const field =
  'mt-2 w-full rounded-(--radius-btn) border border-sand bg-white px-4 py-3 text-base text-iron normal-case tracking-normal placeholder:text-gravel focus:border-copper focus:ring-1 focus:ring-copper focus:outline-none';
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  class="grid gap-5 bg-bone p-6 ring-1 ring-sand sm:grid-cols-2 md:p-10"
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value={`New bid request — ${site.name}`} />
  <input type="hidden" name="from_name" value={site.name} />
  <input type="hidden" name="redirect" value={redirect} />
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    style="display:none"
    tabindex="-1"
    autocomplete="off"
  />

  <fieldset class="sm:col-span-2">
    <legend class={label}>Project type</legend>
    <div class="mt-2 grid gap-2 sm:grid-cols-3">
      {[
        ['Commercial', 'GC, developer, business'],
        ['Municipal', 'Township, village, county'],
        [`Residential ${site.minResidentialAcres}+ acres`, 'Estate or acreage property'],
      ].map(([value, hint], i) => (
        <label class="flex cursor-pointer gap-3 border border-sand bg-white p-4 has-checked:border-copper has-checked:ring-1 has-checked:ring-copper">
          <input
            type="radio"
            name="project_type"
            value={value}
            required
            checked={i === 0}
            class="mt-1 accent-copper"
          />
          <span>
            <span class="block font-semibold">{value}</span>
            <span class="text-sm text-stone">{hint}</span>
          </span>
        </label>
      ))}
    </div>
  </fieldset>

  <label class={label}>
    Name
    <input class={field} type="text" name="name" autocomplete="name" required />
  </label>
  <label class={label}>
    Company / organization <span class="font-normal text-gravel normal-case">(optional)</span>
    <input class={field} type="text" name="organization" autocomplete="organization" />
  </label>
  <label class={label}>
    Phone
    <input class={field} type="tel" name="phone" autocomplete="tel" required />
  </label>
  <label class={label}>
    Email
    <input class={field} type="email" name="email" autocomplete="email" required />
  </label>
  <label class={label}>
    Project location
    <input class={field} type="text" name="location" placeholder="Town, road or address" required />
  </label>
  <label class={label}>
    Approx. size <span class="font-normal text-gravel normal-case">(acres or feet)</span>
    <input class={field} type="text" name="size" placeholder="e.g. 6 acres, 1,200 ft of road" />
  </label>
  <label class={label}>
    Primary service
    <select class={field} name="service" required>
      <option value="">Choose a service…</option>
      {services.map((s) => (
        <option>{s.data.short}</option>
      ))}
      <option>Multiple / not sure</option>
    </select>
  </label>
  <label class={label}>
    Timeline
    <select class={field} name="timeline">
      <option>Flexible</option>
      <option>Within 30 days</option>
      <option>1–3 months</option>
      <option>Bidding a future project</option>
    </select>
  </label>
  <label class:list={[label, 'sm:col-span-2']}>
    Scope / details
    <textarea
      class={field}
      name="message"
      rows="5"
      placeholder="What's on site now, what you need done, and any plans or specs we should see."
    ></textarea>
  </label>
  <div class="flex flex-wrap items-center gap-5 sm:col-span-2">
    <button
      type="submit"
      class="rounded-(--radius-btn) bg-copper px-8 py-4 text-sm font-semibold tracking-[0.1em] text-white uppercase hover:bg-copper-700"
    >
      Submit Bid Request
    </button>
    <p class="text-sm text-stone">
      Prefer to talk? Call{' '}
      <a href={site.phoneHref} class="font-semibold text-copper-600">
        {site.phone}
      </a>
    </p>
  </div>
  <p class="text-sm text-stone sm:col-span-2">
    We focus on commercial, municipal and residential properties of {site.minResidentialAcres} acres
    or more.
  </p>
  {!accessKey && import.meta.env.DEV && (
    <p class="bg-copper-50 p-3 text-sm text-copper-800 sm:col-span-2">
      Dev note: PUBLIC_WEB3FORMS_KEY is not set, so submissions won't deliver.
    </p>
  )}
</form>

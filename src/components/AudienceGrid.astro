---
import { audiences } from '../data/site';
---

<div class="grid gap-px bg-sand ring-1 ring-sand md:grid-cols-3">
  {audiences.map((a, i) => (
    <div class="bg-bone p-8">
      <span class="font-display text-4xl font-medium text-copper">
        {String(i + 1).padStart(2, '0')}
      </span>
      <h3 class="mt-4 text-2xl">{a.title}</h3>
      <p class="mt-3 text-stone">{a.text}</p>
    </div>
  ))}
</div>

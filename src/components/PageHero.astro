---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { eyebrow, title, lede, image, imageAlt = '' } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-ink text-white">
  {image && (
    <Image
      src={image}
      alt={imageAlt}
      widths={[800, 1280, 1920]}
      width={1920}
      quality={60}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 size-full object-cover opacity-40"
    />
  )}
  <div class="container-site py-16 md:py-24">
    {eyebrow && <p class="eyebrow text-lime!">{eyebrow}</p>}
    <h1 class="max-w-3xl text-5xl md:text-7xl">{title}</h1>
    {lede && <p class="mt-5 max-w-2xl text-lg text-chrome-100 md:text-xl">{lede}</p>}
    <slot />
  </div>
</section>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}
const { eyebrow, title, lede, image, imageAlt = '' } = Astro.props;
---

<section
  class:list={['relative isolate overflow-hidden bg-charcoal text-white', !image && 'bg-contours']}
>
  {image && (
    <>
      <Image
        src={image}
        alt={imageAlt}
        widths={[800, 1280, 1920]}
        width={1920}
        quality={60}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 -z-10 size-full object-cover"
      />
      <div
        class="absolute inset-0 -z-10 bg-gradient-to-r from-charcoal/95 via-charcoal/75 to-charcoal/30"
        aria-hidden="true"
      />
    </>
  )}
  <div class="container-site py-20 md:py-28">
    {eyebrow && <p class="eyebrow eyebrow-light">{eyebrow}</p>}
    <h1 class="max-w-4xl text-5xl md:text-7xl">{title}</h1>
    {lede && <p class="mt-6 max-w-2xl text-lg text-white/80 md:text-xl">{lede}</p>}
    <slot />
  </div>
</section>

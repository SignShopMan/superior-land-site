---
import PhoneIcon from './PhoneIcon.astro';
import { site } from '../data/site';
import { url } from '../lib/url';
---

<!-- Sticky call/quote bar on phones — the main conversion path for this business -->
<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 border-t border-graphite bg-ink pb-[env(safe-area-inset-bottom)] md:hidden">
  <a
    href={site.phoneHref}
    class="flex items-center justify-center gap-2 py-4 font-display text-lg font-extrabold text-lime uppercase italic no-underline"
  >
    <PhoneIcon /> Call Now
  </a>
  <a
    href={url('contact/')}
    class="flex items-center justify-center bg-orange py-4 font-display text-lg font-extrabold text-ink uppercase italic no-underline"
  >
    Free Quote
  </a>
</div>

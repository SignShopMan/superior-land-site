---
import { site } from '../data/site';
import { url } from '../lib/url';
---

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 border-t border-white/10 bg-charcoal pb-[env(safe-area-inset-bottom)] md:hidden">
  <a
    href={site.phoneHref}
    class="flex items-center justify-center py-4 text-[13px] font-semibold tracking-[0.12em] text-white uppercase no-underline"
  >
    Call {site.phone}
  </a>
  <a
    href={url('contact/')}
    class="flex items-center justify-center bg-orange py-4 text-[13px] font-semibold tracking-[0.12em] text-charcoal uppercase no-underline"
  >
    Request a Bid
  </a>
</div>

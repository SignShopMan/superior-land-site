---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import { nav, site } from '../data/site';
import { url } from '../lib/url';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
const link = 'inline-block py-2 text-gravel no-underline transition-colors hover:text-white';
---

<footer class="bg-charcoal pb-20 text-white md:pb-0">
  <div class="container-site grid gap-12 py-16 md:grid-cols-[1.5fr_1fr_1fr]">
    <div>
      <Logo variant="badge" class="h-auto w-56" />
      <p class="mt-6 max-w-sm text-gravel">{site.description}</p>
      <a
        href={site.phoneHref}
        class="mt-6 inline-block font-display text-3xl font-semibold tracking-wide text-white no-underline"
      >
        {site.phone}
      </a>
      <p class="mt-1 text-sm text-gravel">{site.hours}</p>
      <p class="mt-1 text-sm text-gravel">
        Based in {site.town}, Ohio · Owner {site.owner}
      </p>
    </div>
    <div>
      <h2 class="mb-5 text-sm tracking-[0.2em] text-orange-400">Services</h2>
      <ul class="space-y-0.5 text-[15px]">
        {services.map((s) => (
          <li>
            <a href={url(`services/${s.id}/`)} class={link}>
              {s.data.short}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="mb-5 text-sm tracking-[0.2em] text-orange-400">Company</h2>
      <ul class="space-y-0.5 text-[15px]">
        {nav.map((n) => (
          <li>
            <a href={url(n.href)} class={link}>
              {n.label}
            </a>
          </li>
        ))}
        <li>
          <a href={url('faq/')} class={link}>
            FAQ
          </a>
        </li>
        <li>
          <a href={url('contact/')} class={link}>
            Request a Bid
          </a>
        </li>
        <li>
          <a href={site.facebook} class={link} rel="noopener">
            Facebook
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="container-site py-6 text-xs tracking-wider text-gravel uppercase">
      © {year} {site.legalName} · {site.region}
    </p>
  </div>
</footer>

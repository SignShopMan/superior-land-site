---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';
import { site } from '../data/site';
import hero from '../assets/photos/municipal-row-berm-restoration.jpg';
---

<Base title="Service Area" description={`Where ${site.name} works: ${site.region}.`}>
  <PageHero
    eyebrow="Service area"
    title={`Serving ${site.region}`}
    lede="Commercial and municipal projects across the region, plus residential properties of three acres or more."
    image={hero}
    imageAlt="Restored roadside berm along farm fields"
  />
  <section class="container-site py-20">
    {site.serviceArea.length > 0 ? (
      <ul class="grid gap-px bg-sand ring-1 ring-sand sm:grid-cols-2 lg:grid-cols-4">
        {site.serviceArea.map((area) => (
          <li class="bg-bone px-5 py-4 font-semibold">{area}</li>
        ))}
      </ul>
    ) : (
      <p class="text-lg text-stone">
        We're based in {site.town}, in {site.county}, and work across {site.region}. Not sure you're
        in range? Call {site.phone} and we'll tell you.
      </p>
    )}
  </section>
  <CTABand />
</Base>

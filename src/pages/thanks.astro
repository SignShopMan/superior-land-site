---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';
import { url } from '../lib/url';
---

<Base title="Request received">
  <section class="container-site py-28 text-center">
    <p class="eyebrow justify-center">Request received</p>
    <h1 class="text-5xl md:text-7xl">Thank you</h1>
    <p class="mx-auto mt-6 max-w-xl text-lg text-stone">
      We'll review the details and follow up to schedule a site walk. For anything time-sensitive,
      call
      <a href={site.phoneHref} class="font-semibold text-orange-700">
        {site.phone}
      </a>
      .
    </p>
    <div class="mt-10">
      <Button href={url('projects/')} variant="outline">
        View Projects
      </Button>
    </div>
  </section>
</Base>

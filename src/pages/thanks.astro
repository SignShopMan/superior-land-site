---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';
import { url } from '../lib/url';
---

<Base title="Thanks — we got it">
  <section class="container-site py-24 text-center">
    <p class="eyebrow">Request received</p>
    <h1 class="text-5xl md:text-7xl">Thanks! We'll be in touch.</h1>
    <p class="mx-auto mt-5 max-w-xl text-lg text-graphite">
      We'll call you back soon to set up a time to look at the job. In a hurry? Call
      <a href={site.phoneHref} class="font-bold text-orange-700">
        {site.phone}
      </a>
      .
    </p>
    <div class="mt-8">
      <Button href={url('projects/')} variant="ghost">
        See our work
      </Button>
    </div>
  </section>
</Base>

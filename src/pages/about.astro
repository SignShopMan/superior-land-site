---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import AudienceGrid from '../components/AudienceGrid.astro';
import CTABand from '../components/CTABand.astro';
import { equipment, site } from '../data/site';
import fleet from '../assets/photos/fleet-truck-gooseneck-excavator.jpg';
---

<Base
  title="About"
  description={`${site.name}: commercial, municipal and acreage site work in ${site.region}.`}
>
  <PageHero
    eyebrow="About"
    title="Owner-led site work"
    lede={`One crew and our own fleet, serving ${site.region}.`}
  />
  <section class="container-site grid items-start gap-14 py-20 lg:grid-cols-2">
    <div class="prose-site">
      <!-- TODO: owner story, years in business, insurance, owner photo -->
      <p>
        {site.name} handles site work across {site.region}: clearing, grading, ponds, drainage,
        access roads and final stabilization. We work with contractors and developers, local
        governments, and owners of large residential properties.
      </p>
      <p>
        We own and haul our equipment, so we're on site when we say we'll be, without waiting on
        rentals.
      </p>
    </div>
    <div>
      <Image
        src={fleet}
        alt="Peterbilt hauling a compact track loader on a gooseneck trailer, beside a John Deere 60G excavator"
        widths={[640, 1024]}
        width={1024}
        sizes="(min-width: 1024px) 50vw, 100vw"
        class="w-full"
      />
      <h2 class="mt-8 text-sm tracking-[0.2em] text-copper-600">Equipment</h2>
      <ul class="mt-4 grid gap-2 text-slate sm:grid-cols-2">
        {equipment.map((e) => (
          <li class="border-l border-copper pl-3 text-[15px]">{e}</li>
        ))}
      </ul>
    </div>
  </section>
  <section class="container-site pb-20">
    <AudienceGrid />
  </section>
  <CTABand />
</Base>

---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import AudienceGrid from '../components/AudienceGrid.astro';
import CTABand from '../components/CTABand.astro';
import Testimonial from '../components/Testimonial.astro';
import { equipment, site } from '../data/site';
import fleet from '../assets/photos/fleet-truck-gooseneck-excavator.jpg';
---

<Base
  title="About"
  description={`${site.name}: commercial, municipal and acreage site work in ${site.region}.`}
>
  <PageHero
    eyebrow="About"
    title="Owner-led site work"
    lede={`${site.owner} has more than ${site.experienceYears} years of experience. One crew, our own fleet, based in ${site.town}, Ohio.`}
  />
  <section class="container-site grid items-start gap-14 py-20 lg:grid-cols-2">
    <div class="prose-site">
      <!-- TODO: owner photo, insurance / certifications once confirmed -->
      <p>
        {site.name} is owned and run by {site.owner}, who brings more than {site.experienceYears}
        years of experience to every job. We're based in {site.town}, in {site.county}, and handle
        site work across {site.region}: clearing, grading, ponds, drainage, access roads and final
        stabilization.
      </p>
      <p>
        We work with contractors and developers, local governments, and owners of large residential
        properties. When you call, you're talking to the person responsible for the work.
      </p>
      <p>
        We own and haul our equipment, so we're on site when we say we'll be, without waiting on
        rentals.
      </p>
    </div>
    <div>
      <Image
        src={fleet}
        alt="Peterbilt hauling a compact track loader on a gooseneck trailer, beside a John Deere 60G excavator"
        widths={[640, 1024]}
        width={1024}
        sizes="(min-width: 1024px) 50vw, 100vw"
        class="w-full"
      />
      <h2 class="mt-8 text-sm tracking-[0.2em] text-orange-700">Equipment</h2>
      <ul class="mt-4 grid gap-2 text-slate sm:grid-cols-2">
        {equipment.map((e) => (
          <li class="border-l border-orange pl-3 text-[15px]">{e}</li>
        ))}
      </ul>
    </div>
  </section>
  <section class="container-site pb-20">
    <AudienceGrid />
  </section>
  <section class="bg-bone py-20">
    <div class="container-site">
      <Testimonial />
    </div>
  </section>
  <CTABand />
</Base>

---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { url } from '../lib/url';
---

<Base title="Page not found">
  <section class="container-site py-28 text-center">
    <p class="eyebrow justify-center">404</p>
    <h1 class="text-5xl md:text-7xl">Page not found</h1>
    <p class="mt-6 text-lg text-stone">That page doesn't exist. Try one of these instead.</p>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <Button href={url()}>Home</Button>
      <Button href={url('services/')} variant="outline">
        Services
      </Button>
    </div>
  </section>
</Base>

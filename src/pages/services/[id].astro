---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Button from '../../components/Button.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CTABand from '../../components/CTABand.astro';
import Testimonial from '../../components/Testimonial.astro';
import { site } from '../../data/site';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({ params: { id: service.id }, props: { service } }));
}

interface Props {
  service: CollectionEntry<'services'>;
}
const { service } = Astro.props;
const { data } = service;
const { Content } = await render(service);
const projects = await getCollection('projects', (p) => p.data.service.id === service.id);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: data.title,
    description: data.summary,
    provider: { '@id': new URL(url('#business'), Astro.site).href },
    areaServed: site.region,
  },
  ...(data.faqs.length
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: data.faqs.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        },
      ]
    : []),
];
---

<Base title={data.metaTitle ?? data.title} description={data.summary} schema={schema}>
  <PageHero
    eyebrow="Services"
    title={data.title}
    lede={data.summary}
    image={data.hero}
    imageAlt={data.heroAlt}
  >
    <div class="mt-10 flex flex-wrap gap-3">
      <Button href={url(`contact/?service=${encodeURIComponent(data.short)}`)} size="lg">
        Request a Bid
      </Button>
      <Button href={site.phoneHref} variant="outline-light" size="lg">
        {site.phone}
      </Button>
    </div>
  </PageHero>

  <section class="container-site grid gap-14 py-20 lg:grid-cols-[1.5fr_1fr]">
    <div class="prose-site">
      <Content />
    </div>
    {data.benefits.length > 0 && (
      <aside class="self-start border-t-2 border-orange bg-bone p-8 ring-1 ring-sand">
        <h2 class="text-2xl">Scope includes</h2>
        <ul class="mt-5 space-y-3 text-slate">
          {data.benefits.map((b) => (
            <li class="border-l border-orange pl-4">{b}</li>
          ))}
        </ul>
      </aside>
    )}
  </section>

  {data.faqs.length > 0 && (
    <section class="bg-sand/60 py-20">
      <div class="container-site max-w-3xl">
        <p class="eyebrow">FAQ</p>
        <h2 class="text-4xl">Common questions</h2>
        <div class="mt-8 divide-y divide-sand border-y border-sand bg-bone px-6">
          {data.faqs.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none justify-between gap-4 text-lg font-semibold [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="text-orange-700 transition group-open:rotate-45" aria-hidden="true">
                  +
                </span>
              </summary>
              <p class="mt-3 text-slate">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  {projects.length > 0 && (
    <section class="container-site py-20">
      <p class="eyebrow">Recent work</p>
      <h2 class="text-4xl">{data.short} projects</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => (
          <ProjectCard project={p} />
        ))}
      </div>
    </section>
  )}

  <section class="bg-bone py-20">
    <div class="container-site">
      <Testimonial />
    </div>
  </section>

  <CTABand service={data.short} />
</Base>

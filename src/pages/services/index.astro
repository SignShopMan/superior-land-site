---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import BidCard from '../../components/BidCard.astro';
import CTABand from '../../components/CTABand.astro';
import { site } from '../../data/site';
import hero from '../../assets/photos/municipal-row-excavator-mulcher.jpg';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Services"
  description={`Commercial, municipal and large-acreage site services in ${site.region}.`}
>
  <PageHero
    eyebrow="Services"
    title="Capabilities"
    lede={`Seven core services for commercial, municipal and ${site.minResidentialAcres}+ acre residential work, all handled by one crew with its own equipment.`}
    image={hero}
    imageAlt="Excavator with a mulching head clearing along a township road"
  />
  <section class="container-site py-20">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s, i) => (
        <ServiceCard service={s} index={i} />
      ))}
      <BidCard />
    </div>
  </section>
  <CTABand />
</Base>

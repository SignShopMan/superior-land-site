---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTABand from '../../components/CTABand.astro';
import { site } from '../../data/site';
import hero from '../../assets/photos/land-clearing-fence-line-excavator.jpg';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Services"
  description={`Land and site services in ${site.region}: driveways, land clearing, grading, ponds, drainage and more.`}
>
  <PageHero
    eyebrow="Services"
    title="Everything from the dirt up"
    lede="One crew, our own machines, and a clean finish on every job."
    image={hero}
    imageAlt="Excavator clearing a tree line along a farm field"
  />
  <section class="container-site py-16">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s) => (
        <ServiceCard service={s} />
      ))}
    </div>
  </section>
  <CTABand />
</Base>

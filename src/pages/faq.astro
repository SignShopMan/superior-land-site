---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

// Answers only use facts the site already states. Add insurance, start times or guarantees
// here once the owner confirms them.
const groups = [
  {
    title: 'Bids and cost',
    items: [
      {
        q: 'How does bidding work?',
        a: `Send us the scope, plans or just the location. We walk the site or review your plans, then return a written, itemized bid with a schedule you can plan around.`,
      },
      {
        q: 'What affects the price?',
        a: 'Mostly the size of the job (acres, or feet of road or ditch), access and ground conditions, how dense the brush and trees are, materials like stone, pipe and seed, and how far they have to be hauled. Plans or a few photos with your request help us bid tighter.',
      },
      {
        q: "Can you bid a project that hasn't started yet?",
        a: 'Yes. Choose "Bidding a future project" in the request form and include your bid due date or construction schedule.',
      },
    ],
  },
  {
    title: 'Who we work for',
    items: [
      {
        q: 'Do you work as a subcontractor?',
        a: 'Yes. We work for general contractors, developers, schools and industrial owners, and coordinate with your schedule and the other trades on site.',
      },
      {
        q: 'Do you work for townships and counties?',
        a: "Yes: roadside and right-of-way clearing, ditch and berm restoration, and culverts. Send the roads or sections and the scope and we'll return a written bid you can take to your trustees.",
      },
      {
        q: 'Do you take residential work?',
        a: `Yes, on properties of ${site.minResidentialAcres} acres or more: clearing, ponds, access drives and grading.`,
      },
      {
        q: 'Where do you work?',
        a: `We're based in ${site.town}, in ${site.county}, and work across ${site.region}. Call ${site.phone} if you're not sure you're in range.`,
      },
    ],
  },
  {
    title: 'The work',
    items: [
      {
        q: 'Who does the work?',
        a: `${site.name} is owner-led by ${site.owner}, who has more than ${site.experienceYears} years of experience. We use our own crew and our own equipment, so there's no waiting on rentals or a second sub.`,
      },
      {
        q: 'What happens to the brush and trees you clear?',
        a: 'A forestry mulcher grinds them in place and leaves a mulch layer that protects the soil. There are no burn piles and nothing to haul away.',
      },
      {
        q: "Do you finish the site when you're done?",
        a: 'Yes. Jobs close out graded and, where the ground needs it, seeded and strawed, ready for the next trade or the owner.',
      },
      {
        q: 'What happens after I send a bid request?',
        a: `We review the details and follow up to set up a site walk. For anything time-sensitive, call ${site.phone}.`,
      },
    ],
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: groups.flatMap((g) =>
      g.items.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    ),
  },
];
---

<Base
  title="FAQ"
  description={`How bids, pricing and the work go with ${site.name}.`}
  schema={schema}
>
  <PageHero
    eyebrow="FAQ"
    title="Questions before you bid"
    lede="How bids work, what drives cost, who we work for, and what happens on site."
  />
  <section class="container-site grid gap-14 py-20 lg:grid-cols-[1fr_2fr]">
    <aside class="self-start lg:sticky lg:top-28">
      <p class="eyebrow">Still have a question?</p>
      <a
        href={site.phoneHref}
        class="font-display text-4xl font-semibold tracking-wide text-charcoal no-underline"
      >
        {site.phone}
      </a>
      <p class="mt-2 text-stone">{site.hours}</p>
      <p class="mt-6">
        <a href={url('contact/')} class="font-semibold text-orange-700 underline">
          Request a bid →
        </a>
      </p>
    </aside>
    <div class="space-y-14">
      {groups.map((g) => (
        <div>
          <h2 class="text-3xl">{g.title}</h2>
          <div class="mt-6 divide-y divide-sand border-y border-sand bg-bone px-6">
            {g.items.map((f) => (
              <details class="group py-5">
                <summary class="flex cursor-pointer list-none justify-between gap-4 text-lg font-semibold [&::-webkit-details-marker]:hidden">
                  {f.q}
                  <span class="text-orange-700 transition group-open:rotate-45" aria-hidden="true">
                    +
                  </span>
                </summary>
                <p class="mt-3 text-slate">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
  <CTABand />
</Base>

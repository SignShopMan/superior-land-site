---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Testimonial from '../components/Testimonial.astro';
import { url } from '../lib/url';
import { site } from '../data/site';
---

<Base
  title="Request a Bid"
  description={`Request a bid for commercial, municipal or ${site.minResidentialAcres}+ acre residential site work in ${site.region}. Call ${site.phone}.`}
>
  <PageHero
    eyebrow="Request a bid"
    title="Tell us about the project"
    lede="Send the scope, plans or just a location. We'll follow up to schedule a site walk."
  />
  <section class="container-site grid gap-12 py-20 lg:grid-cols-[1fr_2fr]">
    <div class="order-2 space-y-8 lg:order-1">
      <div>
        <p class="eyebrow">Direct</p>
        <a
          href={site.phoneHref}
          class="font-display text-4xl font-semibold tracking-wide text-charcoal no-underline"
        >
          {site.phone}
        </a>
        <p class="mt-2 text-stone">{site.hours}</p>
        <p class="mt-1 text-stone">
          Based in {site.town}, Ohio · Owner {site.owner}
        </p>
      </div>
      <div class="border-t border-sand pt-8">
        <h2 class="text-2xl">Helpful to include</h2>
        <ul class="mt-4 space-y-2 text-slate">
          <li class="border-l border-orange pl-4">Site plans, drawings or a scope of work</li>
          <li class="border-l border-orange pl-4">Acreage, or feet of road or ditch</li>
          <li class="border-l border-orange pl-4">Access, and what's on site now</li>
          <li class="border-l border-orange pl-4">Bid due date or construction schedule</li>
        </ul>
        <p class="mt-6 text-sm text-stone">
          Questions first?{' '}
          <a href={url('faq/')} class="font-semibold text-orange-700 underline">
            Read the FAQ
          </a>
        </p>
      </div>
    </div>
    <div class="order-1 lg:order-2">
      <QuoteForm />
    </div>
  </section>
  <section class="bg-bone py-20">
    <div class="container-site">
      <Testimonial />
    </div>
  </section>
</Base>

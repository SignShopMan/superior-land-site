---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CTABand from '../../components/CTABand.astro';
import hero from '../../assets/photos/acreage-homesite-site-prep-drone.jpg';

const projects = (await getCollection('projects')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured),
);
---

<Base title="Projects" description="Commercial, municipal and large-acreage site work projects.">
  <PageHero
    eyebrow="Our work"
    title="Projects"
    lede="Commercial sites, public roads and large rural properties."
    image={hero}
    imageAlt="Aerial view of a new home on acreage surrounded by farm fields"
  />
  <section class="container-site py-20">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => (
        <ProjectCard project={p} />
      ))}
    </div>
  </section>
  <CTABand />
</Base>

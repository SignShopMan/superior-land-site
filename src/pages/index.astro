---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import ServiceCard from '../components/ServiceCard.astro';
import BidCard from '../components/BidCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import AudienceGrid from '../components/AudienceGrid.astro';
import CTABand from '../components/CTABand.astro';
import { equipment, site } from '../data/site';
import { url } from '../lib/url';
import heroImg from '../assets/photos/commercial-site-prep-drone.jpg';
import fleetImg from '../assets/photos/fleet-truck-gooseneck-excavator.jpg';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const featured = (await getCollection('projects', (p) => p.data.featured)).slice(0, 4);

const steps = [
  { title: 'Site walk', text: 'We walk the property or review your plans and scope.' },
  { title: 'Written bid', text: 'A clear, itemized price and a schedule you can plan around.' },
  { title: 'Execution', text: 'Our own crew and equipment, from first cut to final grade.' },
  {
    title: 'Close-out',
    text: 'Seeded, strawed and stabilized, ready for the next trade or the owner.',
  },
];
---

<Base>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-charcoal text-white">
    <Image
      src={heroImg}
      alt="Aerial view of a commercial development with graded and seeded grounds"
      widths={[800, 1280, 1920]}
      width={1920}
      quality={60}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-10 size-full object-cover"
    />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-r from-charcoal via-charcoal/80 to-charcoal/20"
      aria-hidden="true"
    ></div>
    <div class="container-site py-24 md:py-36">
      <p class="eyebrow eyebrow-light">Serving {site.region}</p>
      <h1 class="max-w-4xl text-5xl sm:text-6xl md:text-[5.5rem]">
        Site work for commercial, municipal &amp; acreage projects
      </h1>
      <p class="mt-7 max-w-2xl text-lg text-white/80 md:text-xl">
        Clearing, grading, ponds, drainage, access roads and final stabilization, done with our own
        crew and equipment.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <Button href={url('contact/')} size="lg">
          Request a Bid
        </Button>
        <Button href={url('projects/')} variant="outline-light" size="lg">
          View Projects
        </Button>
      </div>
    </div>
  </section>

  <!-- Who we work with -->
  <section class="container-site py-20 md:py-28">
    <div class="grid gap-6 md:grid-cols-[1fr_1.4fr] md:items-end">
      <div>
        <p class="eyebrow">Who we work with</p>
        <h2 class="text-4xl md:text-6xl">Built for bigger sites</h2>
      </div>
      <p class="max-w-xl text-lg text-stone md:justify-self-end">
        We focus on work where the right equipment and a clean finish matter most: commercial
        builds, public roads and residential properties of {site.minResidentialAcres} acres or more.
      </p>
    </div>
    <div class="mt-12">
      <AudienceGrid />
    </div>
  </section>

  <!-- Services -->
  <section class="bg-sand/60 py-20 md:py-28">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow">Capabilities</p>
          <h2 class="text-4xl md:text-6xl">Services</h2>
        </div>
        <Button href={url('services/')} variant="outline">
          All Services
        </Button>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {services.map((s, i) => (
          <ServiceCard service={s} index={i} />
        ))}
        <BidCard />
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="container-site py-20 md:py-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow">Recent work</p>
        <h2 class="text-4xl md:text-6xl">Projects</h2>
      </div>
      <Button href={url('projects/')} variant="outline">
        All Projects
      </Button>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {featured.map((p) => (
        <ProjectCard project={p} large />
      ))}
    </div>
  </section>

  <!-- Process + fleet -->
  <section class="bg-contours bg-charcoal py-20 text-white md:py-28">
    <div class="container-site grid gap-14 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="eyebrow eyebrow-light">How we work</p>
        <h2 class="text-4xl md:text-6xl">From site walk to final grade</h2>
        <ol class="mt-10 grid gap-px bg-white/10 sm:grid-cols-2">
          {steps.map((s, i) => (
            <li class="bg-charcoal p-6">
              <span class="font-display text-3xl font-medium text-orange-400">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-3 text-xl">{s.title}</h3>
              <p class="mt-2 text-[15px] text-gravel">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
      <div>
        <Image
          src={fleetImg}
          alt="Peterbilt with gooseneck trailer, compact track loader and John Deere 60G excavator"
          widths={[640, 1024]}
          width={1024}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="w-full"
        />
        <h3 class="mt-8 text-sm tracking-[0.2em] text-orange-400">Our own fleet</h3>
        <ul class="mt-4 grid gap-2 text-gravel sm:grid-cols-2">
          {equipment.map((e) => (
            <li class="border-l border-orange pl-3 text-[15px]">{e}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <CTABand />
</Base>
